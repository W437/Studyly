{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "test": "deno test -A tests/",
    "check": "deno check ai/index.ts account/index.ts appstore-notify/index.ts _shared/bundle.ts tests/ tools/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "bundle": "deno run --allow-read=. --allow-write=_shared/generated.ts _shared/bundle.ts",
    "mock-openai": "deno run --allow-net --allow-read=. tests/_mock_openai.ts",
    "live": "deno run -A tools/live_check.ts",
    "live-openai": "deno run -A tools/live_openai.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "_shared/generated.ts",
      "_shared/fixtures/",
      "_shared/prompts/",
      "_shared/schemas/"
    ]
  },
  "lint": {
    "exclude": [
      "_shared/generated.ts"
    ]
  },
  "lock": false
}
