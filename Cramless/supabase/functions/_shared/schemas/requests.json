{
  "$comment": "Request bodies as the relay accepts them: the Swift request types in Cramless/AI/RelayContract.swift, with the size limits the relay enforces. Fields the Swift decoder defaults (GeneratedItem.topic, …) are optional here too. Only the relay's own validator reads this file; it is never sent to a model.",
  "$defs": {
    "ItemKind": { "type": "string", "enum": ["recall", "apply", "mcq", "cloze", "diagram", "flashcard"] },
    "Id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "AnchorId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,40}$" },
    "ShortText": { "type": "string", "maxLength": 300 },
    "Text": { "type": "string", "maxLength": 8000 },
    "LineInput": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/AnchorId" },
        "text": { "type": "string", "maxLength": 4000 }
      },
      "required": ["id", "text"]
    },
    "PageInput": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "label": { "type": "string", "maxLength": 40 },
        "lines": { "type": "array", "maxItems": 800, "items": { "$ref": "#/$defs/LineInput" } },
        "image": { "type": "string", "minLength": 16, "maxLength": 8000000 }
      },
      "required": ["page", "label", "lines"]
    },
    "KeyIdea": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/ShortText" },
        "terms": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/ShortText" } }
      },
      "required": ["id", "label", "terms"]
    },
    "Choice": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 1000 },
        "correct": { "type": "boolean" },
        "why": { "type": "string", "maxLength": 2000 }
      },
      "required": ["text", "correct"]
    },
    "ClozeSpec": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "alternates": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/ShortText" } }
        }
      },
      "required": ["text"]
    },
    "GeneratedItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/ItemKind" },
        "topic": { "$ref": "#/$defs/ShortText" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "answer": { "type": "string", "maxLength": 8000 },
        "explanation": { "$ref": "#/$defs/Text" },
        "keyIdeas": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/KeyIdea" } },
        "choices": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/Choice" } },
        "cloze": { "$ref": "#/$defs/ClozeSpec" },
        "diagramLabels": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/AnchorId" } },
        "anchors": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/AnchorId" } },
        "difficulty": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["id", "kind", "prompt", "answer"]
    },
    "Materials": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 120 }
    },
    "TutorMessage": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 }
      },
      "required": ["role", "text"]
    },
    "RungRequest": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ItemKind" },
        "prompt": { "type": "string", "maxLength": 2000 },
        "answer": { "type": "string", "maxLength": 2000 }
      },
      "required": ["kind", "prompt", "answer"]
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "sourceTitle": { "$ref": "#/$defs/ShortText" },
        "level": { "type": "string", "maxLength": 40 },
        "language": { "type": "string", "minLength": 2, "maxLength": 16 },
        "formats": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/ItemKind" } },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 40 },
        "pages": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/PageInput" } },
        "rung": { "$ref": "#/$defs/RungRequest" }
      },
      "required": ["course", "sourceTitle", "language", "formats", "maxItems", "pages"]
    },
    "CheckReport": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "reason": { "type": "string", "enum": ["answerWrong", "questionUnclear", "myAnswerCounts", "other"] },
        "given": { "type": "string", "maxLength": 2000 },
        "note": { "type": "string", "maxLength": 280 }
      },
      "required": ["id", "reason"]
    },
    "CheckRequest": {
      "type": "object",
      "properties": {
        "pages": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/PageInput" } },
        "items": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/GeneratedItem" } },
        "sourceTitle": { "type": "string", "maxLength": 200 },
        "headings": { "type": "array", "maxItems": 60, "items": { "type": "string", "maxLength": 120 } },
        "lenient": { "type": "boolean" },
        "reports": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/CheckReport" }
        }
      },
      "required": ["pages", "items"]
    },
    "GradeRequest": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ItemKind" },
        "level": { "type": "string", "maxLength": 40 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "modelAnswer": { "type": "string", "maxLength": 8000 },
        "keyIdeas": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/KeyIdea" } },
        "response": { "type": "string", "maxLength": 12000 },
        "sourceExcerpt": { "type": "string", "maxLength": 12000 }
      },
      "required": ["kind", "prompt", "modelAnswer", "keyIdeas", "response"]
    },
    "TutorRequest": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["hints", "explain"] },
        "minor": { "type": "boolean" },
        "course": { "type": "string", "maxLength": 200 },
        "messages": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/TutorMessage" } },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "title": { "$ref": "#/$defs/ShortText" },
              "label": { "type": "string", "maxLength": 120 },
              "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
            },
            "required": ["id", "title", "label", "text"]
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "itemPrompt": { "type": "string", "maxLength": 4000 },
            "expected": { "type": "string", "maxLength": 8000 },
            "given": { "type": "string", "maxLength": 8000 }
          },
          "required": ["itemPrompt", "expected", "given"]
        },
        "materials": { "$ref": "#/$defs/Materials" },
        "fromPhoto": { "type": "boolean" }
      },
      "required": ["mode", "minor", "messages", "sources"]
    },
    "ConfusionsRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "mistakes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "$ref": "#/$defs/Id" },
              "topic": { "$ref": "#/$defs/ShortText" },
              "prompt": { "type": "string", "maxLength": 4000 },
              "expected": { "$ref": "#/$defs/Text" },
              "given": { "$ref": "#/$defs/Text" },
              "misses": { "type": "integer", "minimum": 0, "maximum": 10000 }
            },
            "required": ["itemId", "topic", "prompt", "expected", "given", "misses"]
          }
        },
        "lookAlike": { "type": "boolean" }
      },
      "required": ["course", "mistakes"]
    },
    "LectureRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "title": { "$ref": "#/$defs/ShortText" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4000,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/AnchorId" },
              "start": { "type": "number", "minimum": 0, "maximum": 36000 },
              "end": { "type": "number", "minimum": 0, "maximum": 36000 },
              "text": { "type": "string", "maxLength": 4000 }
            },
            "required": ["id", "start", "end", "text"]
          }
        },
        "flags": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "number", "minimum": 0, "maximum": 36000 },
              "text": { "type": "string", "maxLength": 2000 }
            },
            "required": ["time", "text"]
          }
        },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 40 }
      },
      "required": ["course", "title", "segments", "flags", "maxItems"]
    },
    "CardsFromChatRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "messages": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/TutorMessage" } },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "required": ["messages", "maxItems"]
    },
    "TranscribeImageRequest": {
      "type": "object",
      "properties": {
        "image": { "type": "string", "minLength": 16, "maxLength": 8000000 },
        "page": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "label": { "type": "string", "maxLength": 40 }
      },
      "required": ["image", "page", "label"]
    },
    "EntitlementRequest": {
      "type": "object",
      "properties": {
        "signedTransactions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 20, "maxLength": 30000 }
        }
      },
      "required": ["signedTransactions"]
    },
    "SquadRedeemRequest": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 24 }
      },
      "required": ["code"]
    },
    "SquadRemoveRequest": {
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["memberId"]
    },
    "TutorSourceInput": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/ShortText" },
        "label": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
      },
      "required": ["id", "title", "label", "text"]
    },
    "TutorContextInput": {
      "type": "object",
      "properties": {
        "itemPrompt": { "type": "string", "maxLength": 4000 },
        "expected": { "type": "string", "maxLength": 8000 },
        "given": { "type": "string", "maxLength": 8000 }
      },
      "required": ["itemPrompt", "expected", "given"]
    },
    "AssistantToolName": {
      "type": "string",
      "enum": [
        "search_notes",
        "create_flashcards",
        "create_quiz_questions",
        "create_note",
        "create_exam",
        "start_practice",
        "open_screen",
        "research_web"
      ]
    },
    "StudyTopic": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/AnchorId" },
        "name": { "type": "string", "maxLength": 120 },
        "weak": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "StudyCourse": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/AnchorId" },
        "name": { "type": "string", "maxLength": 200 },
        "sources": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "questions": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "due": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "topics": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/StudyTopic" } }
      },
      "required": ["id", "name", "sources", "questions", "due", "topics"]
    },
    "StudyExam": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/AnchorId" },
        "courseId": { "$ref": "#/$defs/AnchorId" },
        "title": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "readiness": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["id", "courseId", "title", "date", "readiness"]
    },
    "StudyState": {
      "type": "object",
      "properties": {
        "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "currentCourseId": { "$ref": "#/$defs/AnchorId" },
        "courses": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/StudyCourse" } },
        "exams": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/StudyExam" } }
      },
      "required": ["today", "courses", "exams"]
    },
    "AssistantResult": {
      "type": "object",
      "properties": {
        "callId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "output": { "type": "string", "maxLength": 12000 }
      },
      "required": ["callId", "output"]
    },
    "AssistantTurn": {
      "type": "object",
      "properties": {
        "continuation": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } },
        "results": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/AssistantResult" } }
      },
      "required": ["continuation", "results"]
    },
    "AssistantRequest": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["hints", "explain"] },
        "minor": { "type": "boolean" },
        "course": { "type": "string", "maxLength": 200 },
        "messages": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/TutorMessage" } },
        "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/TutorSourceInput" } },
        "context": { "$ref": "#/$defs/TutorContextInput" },
        "materials": { "$ref": "#/$defs/Materials" },
        "study": { "$ref": "#/$defs/StudyState" },
        "tools": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/AssistantToolName" } },
        "turns": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/AssistantTurn" } }
      },
      "required": ["mode", "minor", "messages", "sources", "study", "tools", "turns"]
    },
    "ResearchRequest": {
      "type": "object",
      "properties": {
        "minor": { "type": "boolean" },
        "topic": { "type": "string", "minLength": 2, "maxLength": 200 },
        "focus": { "type": "string", "maxLength": 300 },
        "course": { "type": "string", "maxLength": 200 }
      },
      "required": ["minor", "topic"]
    },
    "SyllabusRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "examTitle": { "type": "string", "maxLength": 200 },
        "today": { "type": "string", "format": "date" },
        "topics": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/AnchorId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 120 }
            },
            "required": ["id", "name"]
          }
        },
        "pages": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/PageInput" } }
      },
      "required": ["course", "today", "topics", "pages"]
    },
    "ExamMentionRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "title": { "$ref": "#/$defs/ShortText" },
        "recordedDay": { "type": "string", "format": "date" },
        "language": { "type": "string", "maxLength": 20 },
        "topics": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 120 } },
        "mentions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "candidates": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "format": "date" } }
            },
            "required": ["id", "text", "candidates"]
          }
        }
      },
      "required": ["course", "title", "recordedDay", "topics", "mentions"]
    },
    "LastLookRequest": {
      "type": "object",
      "properties": {
        "course": { "type": "string", "maxLength": 200 },
        "examTitle": { "$ref": "#/$defs/ShortText" },
        "language": { "type": "string", "maxLength": 20 },
        "ideas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/Id" },
              "topic": { "type": "string", "maxLength": 120 },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "answer": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "lines": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 1000 } }
            },
            "required": ["id", "prompt", "answer", "lines"]
          }
        }
      },
      "required": ["course", "examTitle", "ideas"]
    },
    "Empty": {
      "type": "object",
      "properties": {}
    }
  }
}
