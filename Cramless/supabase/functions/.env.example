# Function secrets for local development. Copy to supabase/functions/.env (gitignored), fill in, and run
#   supabase functions serve --env-file supabase/functions/.env
# On the hosted project set them with `supabase secrets set NAME=value`. Every value here ships empty (a test
# checks it). SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.

# Real mode: the Anthropic key. Without it (and without CRAMLESS_MOCK=1) the AI routes answer `upstream`.
ANTHROPIC_API_KEY=
# Tests and local mocks only: where the Anthropic SDK sends requests (default https://api.anthropic.com).
# From `supabase functions serve` (Docker) the host is host.docker.internal, for example http://host.docker.internal:58499
ANTHROPIC_BASE_URL=
# Ask Cap's tutor on OpenAI. With the key, the tutor answers from OpenAI (GPT 6.1 Terra at low reasoning) and every other
# route stays on Claude; without it the tutor uses Claude Sonnet too. docs/BUILD.md ▸ Ask Cap on OpenAI.
OPENAI_API_KEY=
# Optional: another OpenAI model for the tutor (default gpt-6.1-terra), and how much it thinks first (low, medium, high).
OPENAI_TUTOR_MODEL=
OPENAI_TUTOR_EFFORT=
# Tests and local mocks only: where OpenAI requests go (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# Web research reads only these sites (comma separated, at most 100, no bare top-level domains). Empty: the built-in list in
# _shared/assistant.ts (encyclopedias, open textbooks, universities, public science and health bodies).
RESEARCH_DOMAINS=
# The most one person's model calls may cost in a day, in dollars (default 0.10). Past it the AI routes answer "that's all the
# cloud AI for today" until the person's local midnight; the meters count requests, this counts money. 0 turns it off.
DAILY_COST_CAP_USD=
# 1 = MOCK mode: the AI routes serve the canned replies in _shared/fixtures (after the same auth, validation and
# quota logic), with believable latency. Never set on production.
CRAMLESS_MOCK=
# The app's bundle ID (default com.loopware.Capling).
APPLE_BUNDLE_ID=
# The app's numeric Apple ID from App Store Connect (App Information → Apple ID). Needed to verify Production
# App Store Server Notifications; transactions verify without it.
APPLE_APP_ID=
# Local only: 1 accepts Xcode-environment StoreKit JWS (Cramless.storekit), decoded without a signature check.
# Ignored unless SUPABASE_URL is a local stack.
CRAMLESS_ALLOW_XCODE_JWS=
# Where Squad invite links point (default https://capling.app/squad/).
CRAMLESS_INVITE_BASE_URL=
