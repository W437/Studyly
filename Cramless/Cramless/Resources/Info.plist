			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Anki deck package</string>
			<key>UTTypeIdentifier</key>
			<string>net.ankiweb.apkg</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkg</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Capling looks at when you're busy, on this iPhone, to plan your study around long days. It reads only the times, not what your events are, and nothing from your calendar leaves your iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>Capling uses the camera to scan your textbook pages, handouts and notes into questions. You can also scan a syllabus to set up an exam, or a problem you're stuck on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Capling records the lectures you choose to record and writes them out on this iPhone. It never uploads the recording. It also listens when you answer questions out loud or explain a topic to Cap, and keeps no audio of that.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Capling turns your lecture recordings and spoken answers into words on this iPhone, so you can search your lectures, study from them and answer questions out loud.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
